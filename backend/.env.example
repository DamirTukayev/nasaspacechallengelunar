# Extra origins allowed to call the API, comma-separated (e.g. the deployed frontend).
# Any port on localhost / 127.0.0.1 is allowed by default.
CORS_ORIGINS=

# LOLA south polar DEM in backend/data/dem/ (python -m app.scripts.fetch_dem <name>).
# ldem_75s_120m (116 MB, default) or ldem_75s_240m (29 MB, coarser).
DEM_NAME=ldem_75s_120m
